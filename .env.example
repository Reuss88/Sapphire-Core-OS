# Copy to .env or export these values in your shell before running the scripts.
# Placeholders only. Do not commit real secrets or machine-specific paths.

NEMOTRON_API_KEY=replace-with-a-local-only-api-key
NEMOTRON_HOST=127.0.0.1
NEMOTRON_PORT=8080
NEMOTRON_CONTEXT_SIZE=65536
NEMOTRON_MAX_TOKENS=96
NEMOTRON_ALIAS=nemotron-nano-4b-q4km-local
NEMOTRON_HF_REPO=nvidia/NVIDIA-Nemotron-3-Nano-4B-GGUF
NEMOTRON_HF_QUANT=Q4_K_M
NEMOTRON_HF_FILE=NVIDIA-Nemotron3-Nano-4B-Q4_K_M.gguf

# Override only if Hermes is not already on PATH.
HERMES_BIN=hermes

# Optional.
# HERMES_MODEL_TIMEOUT_SECONDS=90
# SAPPHIRE_RUNTIME_DIR=.runtime
# LLAMA_CPP_RELEASE=b10166

# Supabase development runtime. Local mode is the safe default.
SAPPHIRE_SUPABASE_MODE=local
SAPPHIRE_SUPABASE_LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Remote development fallback only. Keep real values in your local environment
# or CI secret storage; never commit them. See engineering/SUPABASE-DEVELOPMENT-WORKFLOW.md.
# SAPPHIRE_SUPABASE_ENVIRONMENT=development
# SAPPHIRE_SUPABASE_REMOTE_CONFIRM=isolated-development-project
# SAPPHIRE_SUPABASE_PROJECT_REF=replace-with-dedicated-development-project-ref
# SAPPHIRE_SUPABASE_PRODUCTION_PROJECT_REF=replace-with-production-ref-or-none
# SAPPHIRE_SUPABASE_DB_URL=replace-with-percent-encoded-development-database-url
# SUPABASE_ACCESS_TOKEN=replace-with-local-or-ci-secret
# SUPABASE_DB_PASSWORD=replace-with-local-or-ci-secret
