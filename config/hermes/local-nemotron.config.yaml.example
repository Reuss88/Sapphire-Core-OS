model:
  provider: "custom"
  default: "nemotron-nano-4b-q4km-local"
  base_url: "http://127.0.0.1:8080/v1"
  api_key: "replace-with-a-local-only-api-key"
  context_length: 65536
  max_tokens: 96

providers:
  custom:
    request_timeout_seconds: 90
    stale_timeout_seconds: 180

terminal:
  backend: "local"
  cwd: "."
  timeout: 180
  home_mode: "auto"
